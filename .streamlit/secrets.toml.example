# Copie para `.streamlit/secrets.toml` apenas em desenvolvimento local.
# Na nuvem, cadastre estas chaves em Settings › Secrets do Streamlit Cloud.
#
# Use a URL entregue pelo provedor (Neon, Supabase, Render etc.).
# O sistema converte `postgresql://` para o driver `psycopg` automaticamente.

DATABASE_URL = "postgresql://usuario:senha@host/banco?sslmode=require"

# ---------------------------------------------------------------------------
# Recibo de capitação por e-mail (opcional)
# ---------------------------------------------------------------------------
# Sem estas chaves o recibo fica desativado; o resto do sistema continua igual.
# No Gmail, SMTP_PASSWORD deve ser uma "senha de app" (não a senha da conta).

# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_USER = "seuemail@gmail.com"
# SMTP_PASSWORD = "abcd efgh ijkl mnop"
# SMTP_FROM = "Loja Maçônica <seuemail@gmail.com>"
# NOME_LOJA = "Loja Maçônica ... nº ..."
