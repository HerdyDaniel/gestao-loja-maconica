# Copie este arquivo para `.env` e ajuste conforme necessário.
# Sem DATABASE_URL, o sistema usa SQLite em data/loja.db.
# Alternativa ao .env: defina DATABASE_URL em .streamlit/secrets.toml
# (recomendado em servidores e no Streamlit Community Cloud).

# Local (padrão):
# DATABASE_URL=sqlite:///data/loja.db

# Nuvem (exemplo com PostgreSQL):
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/loja_maconica

# Recibo de capitação por e-mail (opcional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=senha-de-app-do-gmail
# SMTP_FROM=Loja Maçônica <seuemail@gmail.com>
# NOME_LOJA=Loja Maçônica ... nº ...
